{
  "layer": "bottom",
  "position": "top",
  "height": 0, // Dejamos que el tamaño de los módulos sea el que mande
  "margin": "0 0 0 0",
  "modules-left": ["hyprland/workspaces", "custom/layout-icon", "custom/music-metadata"],
  "modules-center": ["clock", "privacy"],
  "modules-right": [
    "custom/battery-info",
    "custom/disk-info",
    "pulseaudio",
    "custom/blue-filter",
    "tray"
  ],
  "hyprland/workspaces": {
    "format": "{icon}",
    "tooltip": false,
    "all-outputs": false,
    "sort-by-number": true,
    "disable-scroll": false,
    "on-scroll-up": "hyprctl dispatch workspace +1",
    "on-scroll-down": "hyprctl dispatch workspace -1",
    "active-only": false,
    "show-special": false
  },
  "custom/layout-icon": {
    "tooltip": false,
    "interval": 0.2,
    "exec": "~/.dotfiles/bin/hyprland/print-layout-icon"
  },
  "custom/music-metadata": {
    "tooltip": false,
    "interval": 1,
    "exec": "music-metadata -d",
    "on-click": "music-control play-pause"
  },
  "clock": {
    "tooltip": false,
    "interval": 1,
    "format": "{:%I:%M:%S - %d/%m/%Y}",
    "on-click": "swaync-client -t"
  },
  "privacy": {
    "interval": 1,
    "icon-size": 20
  },
  "custom/battery-info": {
    "tooltip": false,
    "interval": 1,
    "exec": "~/.dotfiles/bin/waybar/battery-info",
    "on-click": "~/.dotfiles/bin/waybar/battery-info-notify"
  },
  "custom/disk-info": {
    "tooltip": false,
    "format": "󰨣 {}",
    "interval": 15,
    "exec": "df -h /home | awk '/[0-9]/ {print $4}'",
    "on-click": "~/.dotfiles/bin/waybar/disks-info-notify"
  },
  "pulseaudio": {
    "tooltip": false,
    "format": "{icon} {volume}%",
    "format-bluetooth": "{icon} {volume}%",
    "format-muted": " {volume}%",
    "format-icons": {
      "headphone": "",
      "default": ["", ""]
    },
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-scroll-up": "volinc 5",
    "on-scroll-down": "volinc -5"
  },
  "custom/blue-filter": {
    "tooltip": false,
    "interval": 1,
    "exec": "~/.dotfiles/bin/waybar/blue-filter-status",
    "on-click": "~/.dotfiles/bin/waybar/blue-filter-toggle"
  },
  "tray": {
    "icon-size": 24,
    "spacing": 2,
    "icons": {
      "discord": "discord-tray",
      "easyeffects": "google-music-manager-panel",
      "qBittorrent": "qbittorrent-tray",
      "redact": "entry-delete",
      "vlc": "vlc-panel",
      "no unread messages": "tray-message" // zulip
    }
  }
}

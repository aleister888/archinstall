#!/bin/bash -x

# Cambiamos el foco de las ventanas de forma cíclica en función de si estamos en
# un espacio normal o en el espacio especial "scratch"

ARG="$1"
[ -z "$ARG" ] && exit 1

#-------------------------------------------------------------------------------

# Indexamos la dirección de las ventanas en el espacio "special:scratch"
# ordenadas en función de la última vez que tuvieron el foco (No usamos el PID
# porque todas las ventanas de kitty que usan --single-instance tienen el mismo
# pid)
index_scratch_addresses() {
	mapfile -t SCRATCH_ADDRESSES < <(
		hyprctl -j clients |
			jq -r '.[]
			| select(.workspace.name=="special:scratch")
			| select(.floating == true and .fullscreen == 0)
			| "\(.focushistoryid):\(.address)"' |
			sort | cut --delimiter=":" --fields="2"
	)
}

get_prop_from_address() {
	hyprctl -j clients | jq -r ".[] | select(.address == $1) | .$2"
}

focus_from_address() {
	hyprctl dispatch "
		hl.dsp.focus({
			window = 'address:$1'
		})
	"
	hyprctl dispatch "
	hl.dsp.window.alter_zorder({
		mode = 'top',
		window = '$1'
	})
"
}

cycle_scratch() {
	index_scratch_addresses

	if [ "${#SCRATCH_ADDRESSES[@]}" -eq 0 ]; then
		return
	fi

	local CURRENT
	CURRENT="$(hyprctl -j activewindow | jq -r '.address')"

	local INDEX=-1

	for i in "${!SCRATCH_ADDRESSES[@]}"; do
		if [ "${SCRATCH_ADDRESSES[$i]}" = "$CURRENT" ]; then
			INDEX=$i
			break
		fi
	done

	# Si no está en la lista, empieza por la última
	if [ "$INDEX" -eq -1 ]; then
		focus_from_address "${SCRATCH_ADDRESSES[-1]}"
		return
	fi

	case "$ARG" in
	prev)
		NEXT=$(((INDEX - 1 + ${#SCRATCH_ADDRESSES[@]}) % ${#SCRATCH_ADDRESSES[@]}))
		;;
	next)
		NEXT=$(((INDEX + 1) % ${#SCRATCH_ADDRESSES[@]}))
		;;
	esac

	focus_from_address "${SCRATCH_ADDRESSES[$NEXT]}"
}

#-------------------------------------------------------------------------------

cycle_master_monocle() {
	case "$ARG" in
	prev) hyprctl eval 'hl.dispatch(hl.dsp.layout("cycleprev"))' ;;
	next) hyprctl eval 'hl.dispatch(hl.dsp.layout("cyclenext"))' ;;
	esac
}

cycle_regular() {
	LAYOUT="$(hyprctl -j activeworkspace | jq -r '.tiledLayout')"
	case "$LAYOUT" in
	master | monocle) cycle_master_monocle ;;
	esac
}

#-------------------------------------------------------------------------------

WORKSPACE="$(hyprctl -j activewindow | jq -r '.workspace.name')"

case "$WORKSPACE" in
"special:scratch") cycle_scratch ;;
*) cycle_regular ;;
esac

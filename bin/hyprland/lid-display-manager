#!/bin/bash
# shellcheck disable=SC2068,SC1091

# Basado en:
# https://www.reddit.com/r/hyprland/comments/18ukvln/comment/mm7m0zr/

IFS=$'\n\t'

source "$HOME/.dotfiles/assets/shell/shell-utils"

# Solo ejecutar en portátiles
ls /sys/class/power_supply/BAT* &>/dev/null || exit 1

INTERNAL_MONITOR="eDP-1"
MONITOR_CONF="$HOME/.config/hypr/hyprland/monitors.lua"

apply_monitor_config() {
	[[ -f "$MONITOR_CONF" ]] || {
		log "archivo no enontrado: $MONITOR_CONF"
		return
	}

	# Aplica la configuración, linea por linea ignorando comentarios
	while IFS= read -r line; do
		if ! echo "$line" | grep -qF -- '--'; then
			hyprctl eval "$line"
		fi
	done < <(
		awk '
		/^hl\.monitor\(\{/ {
		    if (buf != "") print buf
		    buf = $0
		    next
		}
		{
		    gsub(/^[[:space:]]+|[[:space:]]+$/, "")
		    buf = buf " " $0
		}
		END {
		    if (buf != "") print buf
		}' "$MONITOR_CONF"
	)

}

# WORKS
has_external_monitor() {
	# Obtiene los monitores activos y filtra el interno
	hyprctl monitors -j |
		jq -e --arg internal "$INTERNAL_MONITOR" \
			'[.[] | select(.name != $internal)] | length > 0' \
			&>/dev/null
}

lid_state="open"

# Activa/desactiva la pantalla interna en
# función de si la tapa esta cerrada o no
acpi_listen | while read -r event; do
	case "$event" in
	*LID\ close*)
		[[ "$lid_state" == "closed" ]] && continue
		lid_state="closed"
		log "tapa cerrada" INFO
		if has_external_monitor; then
			log "monitor externo detectado, desactivando pantalla interna" INFO
			hyprctl dispatch "hl.monitor({ output = \"$INTERNAL_MONITOR\", disabled = true })" &>/dev/null
		else
			log "sin monitor externo, manteniendo pantalla interna activa" INFO
		fi
		;;

	*LID\ open*)
		[[ "$lid_state" == "open" ]] && continue
		lid_state="open"
		log "tapa abierta" INFO
		if has_external_monitor; then
			hyprctl dispatch \
				"hl.monitor({ output = \"$INTERNAL_MONITOR\", disabled = false })" &>/dev/null
			apply_monitor_config &>/dev/null
		fi
		;;
	esac
done

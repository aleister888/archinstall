#!/bin/sh

WINDOW_WORKSPACE="$(hyprctl -j activewindow | jq -r '.workspace.name')"
CURRENT_WORKSPACE="$(hyprctl -j activeworkspace | jq -r '.id')"
SPECIAL_WORKSPACE="special:scratch"

case "$WINDOW_WORKSPACE" in
"$CURRENT_WORKSPACE")
	hyprctl dispatch \
		"hl.dsp.window.move({ workspace = \"$SPECIAL_WORKSPACE\", follow = false })"
	;;
"$SPECIAL_WORKSPACE")
	hyprctl dispatch \
		"hl.dsp.window.move({ workspace = \"$CURRENT_WORKSPACE\", follow = false })"
	;;
esac

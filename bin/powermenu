#!/bin/bash
# shellcheck disable=SC2086,SC2181

obtener_hora() {
	local HORA
	HORA=$(printf "07:00\n12:00\n17:00\n22:00" |
		fuzzel --dmenu --lines 4 --prompt 'Ingrese una hora (HH:MM): ')

	if [[ $HORA =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]]; then
		echo "$HORA"
	else
		return 1
	fi
}

# Opciones
OPTIONS=(
	"   Bloquear"
	"󰒲   Suspender"
	"󱣶   Suspender hasta las..."
	"   Cerrar sesión"
	"   Reiniciar"
	"   Apagar"
	"󰤄   Hibernar"
	"   BIOS"
)

CHOSEN=$(printf "%s\n" "${OPTIONS[@]}" |
	fuzzel --dmenu --width 20 --lines ${#OPTIONS[@]})

# Maneja la opción elegida
case $CHOSEN in
"${OPTIONS[0]}") lock ;;
"${OPTIONS[1]}") systemctl suspend ;;
"${OPTIONS[2]}")
	HORA=$(obtener_hora)
	if [ $? -eq 0 ]; then
		sudo /usr/local/bin/wakeat "$HORA" now
	fi
	;;
"${OPTIONS[3]}") pkill start-hyprland ;;
"${OPTIONS[4]}") sudo /usr/bin/systemctl reboot ;;
"${OPTIONS[5]}") sudo /usr/bin/systemctl poweroff ;;
"${OPTIONS[6]}") systemctl hibernate ;;
"${OPTIONS[7]}") systemctl reboot --firmware-setup ;;
esac

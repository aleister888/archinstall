#!/bin/bash

OPTIONS=(
	"󰟧   Performance"
	"󰚀   Balanced"
	"󰎏   Power-saver"
)

swaync-client -cp

sleep 0.2

CHOSEN=$(printf "%s\n" "${OPTIONS[@]}" | fuzzel --dmenu --lines 3 --width 13)

case $CHOSEN in
"${OPTIONS[0]}") powerprofilesctl set performance ;;
"${OPTIONS[1]}") powerprofilesctl set balanced ;;
"${OPTIONS[2]}") powerprofilesctl set power-saver ;;
esac
